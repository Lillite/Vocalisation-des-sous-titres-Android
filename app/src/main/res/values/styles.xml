<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="AppThemeBase" />
    <style name="AppThemeBase" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">#C7BFFF</item>
        <item name="colorOnPrimary">#302660</item>
        <item name="colorPrimaryContainer">#473D78</item>
        <item name="colorOnPrimaryContainer">#E7DEFF</item>
        <item name="colorSecondary">#CCC2DC</item>
        <item name="colorOnSecondary">#332D41</item>
        <item name="colorSecondaryContainer">#4A4458</item>
        <item name="colorOnSecondaryContainer">#E8DEF8</item>
        <item name="colorTertiary">#F1B8CF</item>
        <item name="colorSurface">#141218</item>
        <item name="colorSurfaceContainer">#211F26</item>
        <item name="colorSurfaceContainerHigh">#2B2930</item>
        <item name="colorOnSurface">#E6E0E9</item>
        <item name="colorOnSurfaceVariant">#CAC4D0</item>
        <item name="colorOutline">#938F99</item>
        <item name="colorError">#FFB4AB</item>
        <item name="android:colorAccent">#C7BFFF</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#141218</item>
        <item name="android:navigationBarColor">#141218</item>
        <item name="android:windowBackground">#141218</item>
        <item name="android:colorBackground">#141218</item>
        <item name="android:textColorPrimary">#E6E0E9</item>
        <item name="android:textColorSecondary">#CAC4D0</item>
        <item name="materialButtonStyle">@style/PlayerMaterialButton</item>
    </style>
    <style name="PlayerMaterialButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="cornerRadius">20dp</item>
    </style>
</resources>
